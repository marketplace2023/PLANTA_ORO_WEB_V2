# Desarrollo local: Postgres embebido (`npm run db:local`, puerto 54320)
NODE_ENV=development
PORT=3000

# OrÃ­genes permitidos por CORS, separados por coma (URL del frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

DATABASE_URL=postgresql://fur:fur@localhost:54320/fur_dev

# --- Solo al publicar (Neon > Connect) ---
# DATABASE_URL: conexiÃ³n con pooler (host con "-pooler"), la usa la API en runtime.
# DATABASE_URL_UNPOOLED: conexiÃ³n directa, la usan las migraciones. Opcional.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# AutenticaciÃ³n (obligatorio): secreto de firma del access token, >= 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas-caracteres
# Opcionales (valores por defecto):
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Cookie del refresh token: lax si web y API comparten sitio (local); none si son dominios distintos (Render).
# COOKIE_SAMESITE=lax

# Documentos: carpeta local de archivos (en produccion se usara S3) y tamano maximo por archivo
# STORAGE_DIR=./.local/storage
# MAX_UPLOAD_MB=25
